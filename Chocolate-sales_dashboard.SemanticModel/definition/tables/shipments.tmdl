table shipments
	lineageTag: 37f4fe01-d59d-483c-96b9-bbae46b3f493

	measure 'Total Sales Amount' = SUM(shipments[Amount])
		lineageTag: 18106e60-a1d9-4256-a43c-c920ce88601a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Boxes Shipped' = SUM(shipments[Boxes])
		formatString: 0
		lineageTag: cedc080b-7371-4460-86fb-8e9afee8f476

	measure 'Avg Cost per Box' = AVERAGE(products[Cost_per_box])
		lineageTag: bed35b8d-2119-45c6-971f-d2d4f129f91f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Top Performing Salesperson' = ```
			
			VAR TopPerson =
			    TOPN(
			        1,
			        SUMMARIZE(
			            people,
			            people[Sales_person],
			            "PersonSales", [Total Sales Amount]
			        ),
			        [PersonSales],
			        DESC
			    )
			RETURN
			    CONCATENATEX(TopPerson, people[Sales_person], ", ")
			
			```
		lineageTag: c17c5af7-f7ba-41ad-96c6-27350206c73b

